# OIE environment — document every key, no values. Copy to .env and fill in.
# Secrets live ONLY here in .env (gitignored). Never commit real values.

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://oie:oie@localhost:5432/oie?schema=public
AUTH_SECRET=
# Single-operator login (apps/web/auth.ts). REQUIRED in production — without both,
# all logins are denied (fail closed). PASSWORD_HASH is a bcrypt hash, never the
# plaintext: node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'yourpw'
AUTH_OPERATOR_EMAIL=
AUTH_OPERATOR_PASSWORD_HASH=
# Dev-only login opt-in. Leave UNSET in every deployed environment. The dev
# fallback credential (dev@oie.local) is reachable ONLY when this equals "true"
# AND NODE_ENV!=production AND no operator creds are configured.
ALLOW_DEV_LOGIN=
# Safety: DRY_RUN must stay true until the human live-send gate (§3.4). Never auto-flip.
DRY_RUN=true
DAILY_LLM_COST_CAP_USD=25
DAILY_PROVIDER_COST_CAP_USD=50
# Disk guard (addendum §8): halt parallel work if free disk drops below this.
MIN_FREE_DISK_GB=5

# ── LLM ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Enrichment / data ──────────────────────────────────────────────────────
CLAY_WEBHOOK_URL=
CLAY_API_KEY=
EXPLORIUM_API_KEY=
APOLLO_API_KEY=
GOOGLE_MAPS_API_KEY=
# SearchApi.io (Google Maps engine) — alternative discovery source to Google
# Places; no GCP billing needed and returns the business phone inline.
SEARCHAPI_API_KEY=
THEIRSTACK_API_KEY=
BUILTWITH_API_KEY=
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
EXA_API_KEY=

# ── Sending infrastructure ─────────────────────────────────────────────────
SMARTLEAD_API_KEY=
# Resend — alternative EmailSender rail (place your key here; never commit it).
RESEND_API_KEY=

# ── Multichannel messaging ─────────────────────────────────────────────────
UNIPILE_API_KEY=
UNIPILE_DSN=

# ── CRM ────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=

# ── MCP gateway ────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=

# ── Durable workers (Inngest) ──────────────────────────────────────────────
# Server-to-server auth for the /api/inngest serve endpoint. SIGNING_KEY must be
# set in production: it makes inngest/next reject unsigned requests to the
# (publicly-routable) durable-function trigger endpoint.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
# Client-side Sentry DSN (apps/web/instrumentation-client.ts). A DSN is not a
# secret, but it is documented here per the "every key is named in .env.example" rule.
NEXT_PUBLIC_SENTRY_DSN=
